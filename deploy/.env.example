# Copy to /opt/prodflow/.env on the server. Never commit the real .env.
GITHUB_REPOSITORY=your-github-user/prodflow
IMAGE_TAG=latest

# Day 7: replace with the RDS endpoint
DB_URL=jdbc:postgresql://your-rds-endpoint.eu-central-1.rds.amazonaws.com:5432/prodflow
DB_USER=prodflow
DB_PASSWORD=change-me

SPRING_PROFILES_ACTIVE=demo
