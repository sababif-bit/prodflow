# Production configuration for deploy/docker-compose.prod.yml. Copy to deploy/.env ON THE SERVER, fill in real values,
# chmod 600. Never commit the real file; never put these values into user-data, chat or logs. Placeholders only.

# --- public addresses (DuckDNS names for the demo; AUTH_URL/APP_URL are full https URLs without trailing slash)
APP_HOST=app-example.duckdns.org
AUTH_HOST=auth-example.duckdns.org
APP_URL=https://app-example.duckdns.org
AUTH_URL=https://auth-example.duckdns.org

# --- image to run (the pipeline/agent sets the tag; rollback = previous tag)
BACKEND_IMAGE=ghcr.io/sababif-bit/prodflow
IMAGE_TAG=sha-REPLACE

# --- secrets (generate each one, e.g. openssl rand -base64 24)
PRODFLOW_DB_PASSWORD=CHANGE_ME
KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- demo users (first realm import only; >= 12 characters, 6 distinct, different per user, see keycloak/import-guard.sh)
DEMO_PLANNER_PASSWORD=CHANGE_ME
DEMO_PURCHASER_PASSWORD=CHANGE_ME
DEMO_ADMIN_PASSWORD=CHANGE_ME

# --- DuckDNS (scripts/duckdns-update.sh)
DUCKDNS_TOKEN=CHANGE_ME
