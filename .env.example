# ProdFlow local development configuration
# Copy this file to .env and set your own passwords.
# Never commit .env to Git.

KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

KEYCLOAK_DB_PASSWORD=CHANGE_ME

KEYCLOAK_DB_NAME=keycloak
KEYCLOAK_DB_USER=keycloak

# Existing ProdFlow development database
PRODFLOW_DB_PASSWORD=CHANGE_ME

# Demo users of the Keycloak realm (planner, purchaser, admin). Read ONLY when the realm is imported for the first time
# (empty Keycloak database); routine restarts do not need them. keycloak-import-guard refuses the first import unless each
# value has at least 12 characters (>= 6 different ones), differs from the other two and is not a placeholder such as CHANGE_ME.
# Generate real values, e.g.:  openssl rand -base64 18
DEMO_PLANNER_PASSWORD=CHANGE_ME
DEMO_PURCHASER_PASSWORD=CHANGE_ME
DEMO_ADMIN_PASSWORD=CHANGE_ME

# Optional: public URL of the application for the realm's redirect URIs (default: http://localhost:8080)
# PRODFLOW_APP_URL=http://localhost:8080
